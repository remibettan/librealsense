{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 RealSense, Inc.",
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "RealSense camera viewer with REST API backend (FastAPI + React + Tauri).",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [
      "resources/realsense_api/**/*"
    ],
    "shortDescription": "RealSense Viewer",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  },
  "productName": "RealSense Viewer",
  "mainBinaryName": "RealSense Viewer",
  "version": "0.5.0",
  "identifier": "com.realsense.viewer",
  "plugins": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "RealSense Viewer",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}