<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viewer_background">

    <com.intel.realsense.librealsense.GLRsSurfaceView
        android:id="@+id/playbackGlSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/labels_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/file_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:background="@drawable/bg_label_chip"
            android:drawablePadding="6dp"
            android:ellipsize="middle"
            android:gravity="center_vertical"
            android:maxWidth="320dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/viewer_on_overlay"
            app:drawableStartCompat="@drawable/ic_play"
            app:drawableTint="@color/viewer_on_overlay" />

        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_overlay_pill"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playback_open_button"
                style="@style/Widget.RsCamera.ViewerButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open_file"
                app:icon="@drawable/ic_folder" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playback_3d_button"
                style="@style/Widget.RsCamera.ViewerButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/three_d"
                app:icon="@drawable/ic_cube" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
